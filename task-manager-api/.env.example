FLASK_APP=app
FLASK_DEBUG=false

# Obrigatório em produção: gere com `python -c "import secrets;print(secrets.token_hex(32))"`
FLASK_SECRET_KEY=

# Banco (default: sqlite:///tasks.db)
TASK_MANAGER_DATABASE_URI=sqlite:///tasks.db
TASK_MANAGER_HOST=0.0.0.0
TASK_MANAGER_PORT=5000

# SMTP opcional — sem esses valores o envio de e-mail é ignorado
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
